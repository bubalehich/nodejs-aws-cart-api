# node_modules: regenerated inside the builder stage via `npm ci`. Including the
# host folder would bloat build context with hundreds of MB and risk OS-specific
# native modules.
node_modules

# dist: rebuilt by `nest build` in the builder stage. Stale local builds would
# either be overwritten or sneak old code into the image.
dist

# .git: full history is irrelevant at runtime and is the second-largest folder
# in many repos.
.git

# CDK / Terraform output: not part of the application image.
cdk.out
.cdk.staging

# Logs and OS metadata.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store

# Editor / IDE config — local-only.
.vscode
.idea

# Tests and coverage — not shipped to production runtime.
test
coverage
*.spec.ts
*.test.ts

# Environment files — never bake secrets into images.
.env
.env.*
!env.example

# Source-control metadata for other VCSs.
.hg
.svn

# Docker artifacts themselves — avoid recursive context.
Dockerfile
.dockerignore
docker-compose*.yml

# EB CLI working dir.
.elasticbeanstalk
